# Caminho do banco de dados SQLite
# Exemplo: file:./dev.db  (cria o arquivo dev.db dentro da pasta prisma/)
DATABASE_URL="file:./dev.db"

# Chave secreta usada para assinar tokens JWT
# Troque por uma string longa e aleatória em produção
JWT_SECRET="troque-por-um-segredo-forte"

# Porta em que o servidor backend vai escutar (padrão: 3000)
PORT=3000
